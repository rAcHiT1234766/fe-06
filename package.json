{
  "name": "dashkit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "vitest run",
    "storybook": "pnpm --filter @dashkit/sdk storybook",
    "build-storybook": "pnpm --filter @dashkit/sdk build-storybook",
    "size": "pnpm --filter @dashkit/sdk size"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "~8.72.2",
    "vitest": "^5.1.0"
  }
}
