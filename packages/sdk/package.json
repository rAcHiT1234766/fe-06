{
  "name": "@dashkit/sdk",
  "version": "0.1.0",
  "description": "Embeddable, white-label analytics dashboards for React apps and plain HTML pages.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./element": "./dist/dashkit.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/dashkit.js"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vite build --config vite.element.config.ts",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/size.ts",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@dashkit/mock-engine": "workspace:*",
    "@microsoft/api-extractor": "^7.60.1",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "msw": "^3.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.7",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "react-grid-layout": "^2.3.0"
  }
}
